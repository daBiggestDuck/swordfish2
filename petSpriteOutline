	private JPanel postcardPage() {
		JPanel p = card(); p.setLayout(new BorderLayout(10, 10));
		p.add(heading("MOON PEN PALS", "Write a postcard; a CLPS lander carries your words to its lunar home."), BorderLayout.NORTH);
		JTextArea note = new JTextArea("Dear Moon,\n\n", 7, 45); note.setLineWrap(true); note.setWrapStyleWord(true);
		p.add(new JScrollPane(note), BorderLayout.CENTER);
		JPanel bottom = new JPanel(new FlowLayout(FlowLayout.LEFT)); bottom.setOpaque(false);
		JComboBox<String> site = new JComboBox<>(SITES); JButton deliver = button("Send with " + missionBox.getSelectedItem());
		missionBox.addActionListener(e -> deliver.setText("Send with " + missionBox.getSelectedItem()));
		JLabel result = new JLabel("Pick a site and send your note.");
		deliver.addActionListener(e -> result.setText("📬 " + missionBox.getSelectedItem() + " is carrying your postcard to " + site.getSelectedItem() + " (a playful mission postcard)."));
		bottom.add(new JLabel("Destination:")); bottom.add(site); bottom.add(deliver); bottom.add(result); p.add(bottom, BorderLayout.SOUTH);
