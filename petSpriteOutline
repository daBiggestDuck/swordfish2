	private JPanel lostPage() {
		JPanel p = card(); p.setLayout(new BorderLayout(8, 8));
		p.add(heading("LUNAR LOST & FOUND", "A cheerful help desk for real hardware and science on the Moon."), BorderLayout.NORTH);
		String[] items = {"Blue Ghost 1 — Firefly Aerospace lander; carried NASA CLPS payloads.", "LuGRE — lunar GNSS receiver experiment, flown on Blue Ghost 1.", "LEXI — imager studying Earth's magnetosphere from the lunar surface.", "NGLR — a passive lunar retroreflector; it needs no power to reflect laser light.", "Odysseus (IM-1) — Intuitive Machines lander that came to rest tilted."};
