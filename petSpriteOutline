	private JPanel heading(String title, String sub) {
		JPanel h = new JPanel(new GridLayout(0, 1, 0, 4)); h.setOpaque(false);
		JLabel t = new JLabel(title); t.setFont(new Font("SansSerif", Font.BOLD, 17)); t.setForeground(BLUE); h.add(t);
		JLabel s = new JLabel(sub); s.setForeground(INK); h.add(s); return h;
	}

	private JPanel card() { JPanel p = new JPanel(); p.setBackground(Color.WHITE); p.setBorder(BorderFactory.createCompoundBorder(BorderFactory.createLineBorder(new Color(216, 228, 237)), new EmptyBorder(12, 12, 12, 12))); return p; }
	private JButton button(String text) { JButton b = new JButton(text); b.setFocusPainted(false); return b; }
	private JProgressBar meter() { JProgressBar b = new JProgressBar(0, 100); b.setStringPainted(true); b.setPreferredSize(new Dimension(160, 18)); return b; }

	private void updateAll() {
		powerLabel.setText("" + power); warmthLabel.setText("" + warmth); signalLabel.setText("" + signal);
		powerBar.setValue(power); powerBar.setString(power + "%"); warmthBar.setValue(warmth); warmthBar.setString(warmth + "%"); signalBar.setValue(signal); signalBar.setString(signal + "%");
		dayLabel.setText("Lunar day: " + Math.min(14, (int) elapsed) + " / 14");
		scene.repaint(); updatePlan();
	}

	private void updatePlan() {
		String home = (String) siteBox.getSelectedItem(); if (home == null) return;
		LocalDate date = ((java.util.Date) datePicker.getValue()).toInstant().atZone(java.time.ZoneId.systemDefault()).toLocalDate();
		int estimate = estimatePower(home, date);
		String earth = ((date.getDayOfYear() + home.length()) % 5 == 0) ? "Not visible (estimate)" : "Visible for a radio link (estimate)";
		StringBuilder text = new StringBuilder("<html><b>Home: ").append(home).append("</b><br>Landing date: ").append(date.format(DateTimeFormatter.MEDIUM)).append("<br>☀ Estimated solar opportunity: ").append(estimate).append("%<br>🌍 Earth: ").append(earth).append("<br><br><b>Sun & Earth at the site</b><br>Sun height: ").append(10 + estimate / 3).append("° above horizon (illustrative)<br>Horizon and terrain affect real visibility.");
		String compare = (String) compareBox.getSelectedItem();
		if (compare != null && !compare.equals(home)) text.append("<br><br><b>Side-by-side: ").append(compare).append("</b><br>Solar opportunity: ").append(estimatePower(compare, date)).append("%<br>Earth visibility: planning estimate");
		planLabel.setText(text.append("</html>").toString());
	}

	private int estimatePower(String site, LocalDate date) {
		int offset = site.equals("Mare Crisium") ? 0 : site.equals("Mons Mouton") ? 13 : site.equals("Malapert A") ? 8 : 18;
		return Math.max(12, Math.min(96, 58 + (int) (18 * Math.sin((date.getDayOfYear() + offset) * Math.PI / 182.5)) + (site.length() % 9)));
	}

	private void findBestDate() {
		String site = (String) siteBox.getSelectedItem(); LocalDate best = LocalDate.now(); int score = -1;
		for (int i = 0; i < 365; i++) { LocalDate d = LocalDate.now().plusDays(i); int s = estimatePower(site, d); if (s > score) { score = s; best = d; } }
		datePicker.setValue(java.util.Date.from(best.atStartOfDay(java.time.ZoneId.systemDefault()).toInstant()));
		statusLabel.setText("Best estimated solar opportunity in the next year: " + best + "."); updatePlan();
	}

	private void togglePlay() {
		if (elapsed >= 14) { elapsed = 0; eventIndex = 0; stories.clear(); science = 0; power = 76; warmth = 68; signal = 54; }
		running = !running; if (running) timer.start(); else timer.stop();
		statusLabel.setText(running ? "Lunar day in progress — 14 days in about 25 seconds." : "Simulation paused.");
	}

	private void advance() {
		if (!running || popupOpen) return;
		elapsed += .056;
		power = Math.max(0, power - 1);
		if (heaterOn && power > 0) { warmth = Math.min(100, warmth + 1); power = Math.max(0, power - 1); }
		else warmth = Math.max(5, warmth - (elapsed > 9 ? 2 : 1));
		signal = Math.max(10, signal - (elapsed > 10 ? 2 : 1));
		if (eventIndex < eventDays.length && elapsed >= eventDays[eventIndex]) showMissionMoment(eventIndex++);
		if (elapsed >= 14) { elapsed = 14; running = false; timer.stop(); statusLabel.setText("Lunar day complete! Your pet earned a passport."); showPassport(); }
		updateAll();
	}

	private void showMissionMoment(int index) {
		running = false; popupOpen = true; timer.stop();
		String title = eventTitles[index]; stories.add(title);
		JTextArea body = new JTextArea(eventText[index] + "\n\nNASA source: " + eventUrls[index]); body.setWrapStyleWord(true); body.setLineWrap(true); body.setEditable(false); body.setOpaque(false); body.setColumns(40); body.setRows(5);
		JPanel content = new JPanel(new BorderLayout(5, 8)); content.add(body, BorderLayout.CENTER);
		JButton source = button("Open NASA source"); source.addActionListener(e -> openUrl(eventUrls[index])); content.add(source, BorderLayout.SOUTH);
		JOptionPane.showMessageDialog(this, content, "Mission moment • " + title, JOptionPane.INFORMATION_MESSAGE);
		popupOpen = false;
		if (elapsed < 14) { running = true; timer.start(); }
	}

	private void showPassport() {
		String mission = (String) missionBox.getSelectedItem(), site = (String) siteBox.getSelectedItem();
		String source = mission.startsWith("Blue Ghost") ? "https://www.nasa.gov/missions/clps/firefly-aerospace/" : "https://www.nasa.gov/commercial-lunar-payload-services/";
		String met = mission.startsWith("Blue Ghost") ? "LuGRE, LEXI, LMS, NGLR and more" : "Blue Moon Mark 1 mission profile";
		String passport = "MOON PAL PET PASSPORT\nPet: " + mission + " lander\nMission: " + mission + "\nHome: " + site + "\nDays survived: " + (int) elapsed + " / 14\nRating: " + (elapsed >= 14 ? "Lunar legend ★★★★★" : elapsed >= 7 ? "Brave explorer ★★★★☆" : "Moon trainee ★★★☆☆") + "\nScience sent home: " + science + " notes; " + met + "\nStories met: " + (stories.isEmpty() ? "No mission moments yet" : String.join(", ", stories)) + "\nNASA: " + source;
		JTextArea text = new JTextArea(passport, 12, 44); text.setEditable(false); text.setLineWrap(true); text.setWrapStyleWord(true);
		JButton copy = button("Copy passport"); copy.addActionListener(e -> { Toolkit.getDefaultToolkit().getSystemClipboard().setContents(new StringSelection(passport), null); copy.setText("Copied ✓"); });
		JButton link = button("Open NASA source"); link.addActionListener(e -> openUrl(source));
		JPanel panel = new JPanel(new BorderLayout(8, 8)); panel.add(new JScrollPane(text), BorderLayout.CENTER); JPanel buttons = new JPanel(); buttons.add(copy); buttons.add(link); panel.add(buttons, BorderLayout.SOUTH);
		JOptionPane.showMessageDialog(this, panel, "Your Pet Passport", JOptionPane.PLAIN_MESSAGE);
	}

	private void openUrl(String address) { try { if (Desktop.isDesktopSupported()) Desktop.getDesktop().browse(new java.net.URI(address)); } catch (Exception ex) { statusLabel.setText("Could not open link: " + address); } }

	private class PetScene extends JPanel {
		PetScene() { setBackground(new Color(15, 27, 49)); }
		protected void paintComponent(Graphics raw) {
			super.paintComponent(raw); Graphics2D g = (Graphics2D) raw.create(); g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
			int w = getWidth(), h = getHeight();
			g.setColor(new Color(235, 240, 255)); for (int i = 0; i < 34; i++) { int x = (i * 73 + 19) % Math.max(1, w); int y = (i * 47 + 13) % Math.max(1, h / 2); g.fillOval(x, y, i % 4 == 0 ? 3 : 2, i % 4 == 0 ? 3 : 2); }
			g.setColor(new Color(235, 195, 115)); g.fillOval(w - 76, 35, 40, 40);
			g.setColor(new Color(142, 135, 131)); g.fillOval(-30, h - 88, w + 60, 130);
			g.setColor(new Color(116, 111, 110)); for (int i = 0; i < 12; i++) g.fillOval((i * 61) % Math.max(1, w), h - 42 - (i % 3) * 9, 15 + i % 15, 5);
			int cx = w / 2, cy = h - 110;
			// Blue Ghost and Blue Moon are shown as distinct, friendly lander mascots.
			g.setColor(new Color(45, 122, 176)); g.fillRoundRect(cx - 32, cy - 35, 64, 55, 12, 12);
			if (missionBox.getSelectedIndex() == 0) {
				g.setColor(new Color(60, 151, 196)); g.fillRect(cx - 100, cy - 18, 59, 30); g.fillRect(cx + 41, cy - 18, 59, 30);
				g.setColor(new Color(115, 202, 224)); for (int x = cx - 94; x < cx - 43; x += 13) g.drawLine(x, cy - 17, x, cy + 10); for (int x = cx + 47; x < cx + 99; x += 13) g.drawLine(x, cy - 17, x, cy + 10);
			} else {
				g.setColor(new Color(124, 183, 205)); g.fillRoundRect(cx - 84, cy - 24, 42, 37, 8, 8); g.fillRoundRect(cx + 42, cy - 24, 42, 37, 8, 8);
				g.setColor(new Color(166, 217, 226)); g.fillOval(cx - 18, cy - 52, 36, 27);
			}
			g.setColor(new Color(227, 239, 244)); g.fillOval(cx - 17, cy - 21, 10, 12); g.fillOval(cx + 7, cy - 21, 10, 12);
			g.setColor(INK); g.fillOval(cx - 14, cy - 18, 4, 6); g.fillOval(cx + 10, cy - 18, 4, 6);
			g.setColor(new Color(255, 190, 186)); g.fillOval(cx - 23, cy - 7, 9, 5); g.fillOval(cx + 14, cy - 7, 9, 5);
			g.setColor(Color.WHITE); g.setFont(new Font("SansSerif", Font.BOLD, 14)); g.drawString(missionBox.getSelectedIndex() == 0 ? "Blue Ghost 1" : "Blue Moon Mark 1", 14, 24);
			String mood = elapsed > 10 ? "night mode — NGLR sleeps" : elapsed > 7 ? "brr… sunset is coming" : elapsed > 2 ? "happy in the sunshine!" : "warming up…";
			g.setFont(new Font("SansSerif", Font.PLAIN, 13)); g.drawString(mood, 14, h - 16); g.dispose();
		}
	}

