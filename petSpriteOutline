		JTextArea story = new JTextArea("When the Sun slipped below the horizon, the little lander tucked its panels in and watched the stars. Its powered instruments rested, while the tiny retroreflector waited quietly—no power required.\n\nThe night was long, but morning would come again.");
		story.setEditable(false); story.setLineWrap(true); story.setWrapStyleWord(true); story.setFont(new Font("Serif", Font.PLAIN, 20)); story.setBackground(new Color(20, 31, 56)); story.setForeground(new Color(235, 239, 255)); story.setBorder(new EmptyBorder(28, 30, 28, 30));
		p.add(story, BorderLayout.CENTER); return p;
