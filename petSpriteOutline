/** A small, self-contained Swing game about real lunar missions. */
public class Pet_1 extends JFrame {
	private static final Color INK = new Color(31, 47, 70);
	private static final Color BLUE = new Color(39, 103, 166);
	private static final Color PALE = new Color(238, 246, 251);
	private static final String[] SITES = {"Mare Crisium", "Mons Mouton", "Malapert A", "Reiner Gamma"};
	private static final String[] MISSIONS = {"Blue Ghost 1", "Blue Moon Mark 1"};
	private final JComboBox<String> missionBox = new JComboBox<>(MISSIONS);
	private final JComboBox<String> siteBox = new JComboBox<>(SITES);
	private final JComboBox<String> compareBox = new JComboBox<>(SITES);
	private final JSpinner datePicker = new JSpinner(new SpinnerDateModel());
	private final JLabel powerLabel = new JLabel();
	private final JLabel warmthLabel = new JLabel();
	private final JLabel signalLabel = new JLabel();
	private final JLabel dayLabel = new JLabel("Lunar day: 0 / 14");
	private final JLabel statusLabel = new JLabel("Choose a home, then press Play.");
	private final JLabel planLabel = new JLabel();
	private final PetScene scene = new PetScene();
	private final JProgressBar powerBar = meter();
	private final JProgressBar warmthBar = meter();
	private final JProgressBar signalBar = meter();
	private final Timer timer;
	private final List<String> stories = new ArrayList<>();
	private int power = 76, warmth = 68, signal = 54, science = 0;
	private double elapsed;
	private boolean running, popupOpen, heaterOn;
	private int eventIndex;
	private final double[] eventDays = {2.0, 5.2, 8.7, 11.4};
	private final String[] eventTitles = {
		"Blue Ghost 1: a lunar sunset", "IM-1: a tilted landing", "LuGRE: finding the way", "Blue Ghost 1: science at work"
	};
	private final String[] eventText = {
		"Firefly Aerospace's Blue Ghost Mission 1 captured a view of sunset from the Moon. The changing light is beautiful—and a real challenge for solar-powered landers.",
		"Intuitive Machines' IM-1 lander, Odysseus, came to rest tilted after landing. Mission teams adapted operations to the vehicle's position.",
		"The Lunar GNSS Receiver Experiment (LuGRE) demonstrated reception of navigation signals far beyond Earth orbit, including at the lunar surface.",
		"Blue Ghost carried NASA payloads including LEXI, LMS, and the Next Generation Lunar Retroreflector. Each one studies a different part of the Moon environment."
	};
	private final String[] eventUrls = {
		"https://www.nasa.gov/missions/clps/firefly-aerospace/", "https://www.nasa.gov/missions/artemis/clps/nasas-intuitive-machines-moon-landing/",
		"https://nasa.gov/", "https://www.nasa.gov/missions/clps/firefly-aerospace/"
	};

	public Pet_1() {
		super("Moon Pals — lunar lander pets");
		setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
		setMinimumSize(new Dimension(900, 690));
		setSize(1100, 790);
		setLocationRelativeTo(null);
		datePicker.setEditor(new JSpinner.DateEditor(datePicker, "MMM d, yyyy"));
		timer = new Timer(100, e -> advance());
		setContentPane(build());
		updateAll();
	}

	private JPanel build() {
		JPanel root = new JPanel(new BorderLayout(12, 12));
		root.setBackground(PALE);
		root.setBorder(new EmptyBorder(14, 18, 14, 18));
		JPanel header = new JPanel(new BorderLayout());
		header.setOpaque(false);
		JLabel title = new JLabel("MOON PALS  ☾");
		title.setFont(new Font("SansSerif", Font.BOLD, 25));
		title.setForeground(INK);
		JLabel subtitle = new JLabel("Two real CLPS missions. One very lunar day.");
		subtitle.setForeground(new Color(91, 112, 132));
		header.add(title, BorderLayout.NORTH);
		header.add(subtitle, BorderLayout.SOUTH);
		root.add(header, BorderLayout.NORTH);

		JTabbedPane tabs = new JTabbedPane();
		tabs.addTab("Pet & mission", dashboard());
		tabs.addTab("Moon Pen Pals", postcardPage());
		tabs.addTab("Night Nightlight", nightPage());
		tabs.addTab("Recipe Box", recipePage());
		tabs.addTab("Lost & Found", lostPage());
		root.add(tabs, BorderLayout.CENTER);
		return root;
	}

