		JPanel page = new JPanel(new BorderLayout(12, 10));
		page.setOpaque(false);
		JPanel controls = card();
		controls.setLayout(new FlowLayout(FlowLayout.LEFT, 9, 8));
		controls.add(new JLabel("Mission")); controls.add(missionBox);
		controls.add(new JLabel("Home")); controls.add(siteBox);
		controls.add(new JLabel("Landing date")); controls.add(datePicker);
		JButton best = button("Best landing date");
		best.addActionListener(e -> findBestDate()); controls.add(best);
		JButton play = button("▶  Play / Pause");
		play.addActionListener(e -> togglePlay()); controls.add(play);
		missionBox.addActionListener(e -> { scene.repaint(); updateAll(); });
		siteBox.addActionListener(e -> updateAll());
		datePicker.addChangeListener(e -> updatePlan());
		page.add(controls, BorderLayout.NORTH);

		JPanel center = new JPanel(new GridLayout(1, 2, 12, 0));
		center.setOpaque(false);
		JPanel petCard = card(); petCard.setLayout(new BorderLayout(6, 8));
		scene.setPreferredSize(new Dimension(400, 290));
		petCard.add(scene, BorderLayout.CENTER);
		JPanel status = new JPanel(new BorderLayout(5, 5)); status.setOpaque(false);
		JPanel meters = new JPanel(new GridLayout(3, 2, 8, 5)); meters.setOpaque(false);
		meters.add(new JLabel("Power ☀")); meters.add(powerBar);
		meters.add(new JLabel("Warmth 🌡")); meters.add(warmthBar);
		meters.add(new JLabel("Signal 📡")); meters.add(signalBar);
		status.add(meters, BorderLayout.CENTER);
		JPanel care = new JPanel(new FlowLayout(FlowLayout.LEFT, 7, 0)); care.setOpaque(false);
		JButton tilt = button("Tilt panels ☀"); tilt.addActionListener(e -> { power = Math.min(100, power + 14); statusLabel.setText("Panels tilted toward the Sun."); updateAll(); });
		JButton heater = button("Heater: " + (heaterOn ? "ON" : "OFF")); heater.addActionListener(e -> { heaterOn = !heaterOn; heater.setText("Heater: " + (heaterOn ? "ON" : "OFF")); statusLabel.setText(heaterOn ? "Heater on; it uses power." : "Heater off."); });
		JButton link = button("Wait for Earth link 📡"); link.addActionListener(e -> { signal = Math.min(100, signal + 18); statusLabel.setText("Earth is in view; signal improved."); updateAll(); });
		care.add(tilt); care.add(heater); care.add(link);
		status.add(care, BorderLayout.SOUTH);
		petCard.add(status, BorderLayout.SOUTH);
		center.add(petCard);

		JPanel right = card(); right.setLayout(new BoxLayout(right, BoxLayout.Y_AXIS));
		JLabel planTitle = new JLabel("SUN & EARTH PLANNER"); planTitle.setFont(new Font("SansSerif", Font.BOLD, 15)); planTitle.setForeground(BLUE);
		right.add(planTitle); right.add(Box.createVerticalStrut(8));
		planLabel.setVerticalAlignment(SwingConstants.TOP); planLabel.setForeground(INK);
		right.add(planLabel); right.add(Box.createVerticalStrut(14));
		right.add(new JLabel("Compare with a second site:"));
		right.add(compareBox); compareBox.addActionListener(e -> updatePlan());
		right.add(Box.createVerticalStrut(8));
		JLabel caveat = new JLabel("Planning estimates only—not mission navigation data.");
		caveat.setFont(new Font("SansSerif", Font.ITALIC, 11)); caveat.setForeground(Color.GRAY); right.add(caveat);
		right.add(Box.createVerticalGlue());
		JLabel day = new JLabel("LUNAR DAY"); day.setForeground(BLUE); day.setFont(new Font("SansSerif", Font.BOLD, 14)); right.add(day);
		dayLabel.setFont(new Font("SansSerif", Font.BOLD, 19)); dayLabel.setForeground(INK); right.add(dayLabel);
		right.add(statusLabel); right.add(Box.createVerticalStrut(10));
		JButton passport = button("Get Pet Passport ✨"); passport.addActionListener(e -> showPassport()); right.add(passport);
